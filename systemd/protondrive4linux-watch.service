[Unit]
Description=Proton Drive live sync (protondrive4linux watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path to wherever you installed the binary (see protondrive4linux.service).
ExecStart=/usr/bin/protondrive4linux watch
Restart=on-failure
RestartSec=30
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
