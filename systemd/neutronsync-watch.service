[Unit]
Description=Proton Drive live sync (neutronsync watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path to wherever you installed the binary (see neutronsync.service).
ExecStart=/usr/bin/neutronsync watch
Restart=on-failure
RestartSec=30
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
